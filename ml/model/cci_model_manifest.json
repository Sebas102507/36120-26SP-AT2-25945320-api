{
  "version": 1,
  "target": "comfort_climate",
  "experiment": "cci_lstm_multihorizon",
  "model_family": "lstm",
  "adapter": "torchscript",
  "input_kind": "sequence",
  "model_file": "cci_lstm_multihorizon.torchscript.pt",
  "input_scaler_file": "cci_lstm_multihorizon_input_scaler.joblib",
  "target_scaler_file": "cci_lstm_multihorizon_target_scaler.joblib",
  "metadata_file": "cci_lstm_multihorizon_metadata.json",
  "sequence_features": [
    "temperature_2m",
    "relative_humidity_2m",
    "wind_speed_10m",
    "cloud_cover",
    "precipitation",
    "wind_gusts_10m",
    "cci",
    "doy_sin",
    "doy_cos"
  ],
  "lookback_days": 14,
  "horizons_days": [
    1,
    2,
    3
  ],
  "target_inversion": {
    "type": "residual_plus_feature",
    "feature": "cci"
  }
}